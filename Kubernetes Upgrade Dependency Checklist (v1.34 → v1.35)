Kubernetes Upgrade Dependency Checklist (v1.34 → v1.35)
File: k8s-upgrade-dependency-checklist.yaml

cluster: current_version: "1.34" target_version: "1.35" environment: "production"

pre_upgrade_checks:

name: Kubernetes Cluster Version description: Verify current Kubernetes version command: kubectl version --short
name: Node Health Check description: Ensure all worker and master nodes are Ready command: kubectl get nodes -o wide
name: Pod Health Check description: Ensure all pods are running successfully command: kubectl get pods -A
name: Failed Pods Check description: Identify CrashLoopBackOff or Error state pods command: kubectl get pods -A | egrep 'CrashLoopBackOff|Error|Pending'
name: API Deprecation Check description: Detect deprecated APIs before upgrade command: kubectl get apiservices
name: Deprecated API Usage description: Check manifests using removed/deprecated APIs command: kubectl api-resources
name: Cluster Events description: Review recent warning/error events command: kubectl get events -A --sort-by=.metadata.creationTimestamp
name: CRD Compatibility description: Validate Custom Resource Definitions compatibility command: kubectl get crds
name: Helm Releases description: Verify Helm release health and versions command: helm list -A
name: Helm Deprecated APIs description: Validate Helm charts against Kubernetes 1.35 command: helm repo list
name: Ingress Controller Status description: Validate ingress controller readiness command: kubectl get pods -n ingress-nginx
name: Metrics Server Validation description: Ensure metrics server is operational command: kubectl top nodes
name: CSI Driver Compatibility description: Validate CSI storage drivers command: kubectl get csidrivers
name: Storage Classes description: Verify storage class availability command: kubectl get storageclass
name: Persistent Volumes description: Check PV and PVC health command: kubectl get pv,pvc -A
name: CNI Plugin Validation description: Verify networking plugin compatibility command: kubectl get pods -n kube-system
name: CoreDNS Health description: Validate CoreDNS pods status command: kubectl get pods -n kube-system -l k8s-app=kube-dns
name: kube-proxy Health description: Validate kube-proxy daemonset command: kubectl get ds -n kube-system kube-proxy
name: Resource Utilization description: Verify cluster CPU and memory usage command: kubectl top pods -A
name: Pod Security Policies / Admission Controllers description: Verify admission controller compatibility command: kubectl get validatingwebhookconfigurations,mutatingwebhookconfigurations
name: RBAC Validation description: Verify RBAC resources command: kubectl get clusterrole,clusterrolebinding
name: Backup Validation description: Ensure ETCD and application backups are completed command: echo "Verify ETCD snapshot and Velero backup status"
name: ETCD Health description: Validate ETCD cluster health command: kubectl get pods -n kube-system -l component=etcd
name: Admission Webhooks description: Validate webhook services and certificates command: kubectl get validatingwebhookconfigurations,mutatingwebhookconfigurations
name: Namespace Health description: Ensure no namespace is stuck in terminating state command: kubectl get ns

post_upgrade_validation:

name: Cluster Version Validation description: Confirm cluster upgraded successfully command: kubectl version --short
name: Node Version Validation description: Verify all nodes upgraded to target version command: kubectl get nodes -o wide
name: System Pods Validation description: Ensure kube-system pods are healthy command: kubectl get pods -n kube-system
name: Application Validation description: Validate application pods after upgrade command: kubectl get pods -A
name: Ingress Validation description: Verify ingress traffic routing command: kubectl get ingress -A
name: DNS Resolution Test description: Validate cluster DNS functionality command: kubectl run dns-test --image=busybox:1.36 --rm -it -- nslookup kubernetes.default
name: Storage Validation description: Validate PVC mounting and storage functionality command: kubectl get pvc -A
name: Metrics Validation description: Confirm metrics server functionality command: kubectl top nodes

recommendations:

Take ETCD snapshot before upgrade
Backup all Helm values and manifests
Validate all third-party operators compatibility with Kubernetes 1.35
Upgrade staging cluster before production
Review Kubernetes 1.35 release notes for removed APIs
Monitor cluster for 24 hours after upgrade

